# Server Port
PORT=5000

# MongoDB Connection String
# For local MongoDB: mongodb://127.0.0.1:27017/contact_manager
# For MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/contact_manager?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/contact_manager

# JWT Secret & Expiry
JWT_SECRET=supersecret_jwt_key_contact_manager_development_token_2026
JWT_EXPIRES_IN=7d

# Allowed Frontend Origins (comma-separated or single)
CORS_ORIGIN=http://localhost:5173
